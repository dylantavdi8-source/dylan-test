# Required for real agent intelligence. Without this set, the server automatically
# falls back to a clearly-labeled MOCK LLM provider so the orchestration engine can
# still be exercised end-to-end (planning, handoffs, real eBay tool calls, retries,
# guardrails) without fabricating model output.
ANTHROPIC_API_KEY=

# Model to use for all agents (must support tool use).
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Server port
PORT=8787

# Root directory (relative to server/) where per-run sandboxed workspaces are created.
# (Not used by the eBay agents themselves -- kept for the orchestration engine's own
# infrastructure, harmless if unused.)
RUN_WORKSPACES_DIR=run-workspaces

# SQLite file path (relative to server/) for run/task history.
DB_PATH=data/ai-team.sqlite

# --- eBay integration ---------------------------------------------------------------
# Without these three set, the server falls back to a clearly-labeled MOCK eBay client
# (a small in-memory store of fake listings/orders/messages) so the whole system --
# including a real floor-price rejection and the compliance retry loop it triggers --
# can be exercised end-to-end with zero risk to a real account.
#
# To get these: register an app at developer.ebay.com, then use their OAuth "Get a
# Token from eBay via Your Application" tool (under User Tokens) to complete the
# one-time consent flow for your seller account and obtain a refresh token. That
# consent step must be done once, manually, through eBay's own UI -- it can't be
# automated from here.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=

# "sandbox" (eBay's test environment -- recommended first) or "production" (your real,
# live store). Start in sandbox and confirm everything behaves as expected before ever
# switching this to production.
EBAY_ENV=sandbox

# Which eBay marketplace to operate against.
EBAY_MARKETPLACE_ID=EBAY_US

# Required by the Sell Inventory API when creating a new listing (a location you've
# already set up under Business Policies / inventory locations in your eBay account).
EBAY_MERCHANT_LOCATION_KEY=default

# SAFETY GATE -- independent of whether real credentials are configured above. Until
# this is exactly "true", every action that would change something real (creating or
# updating a listing, changing price/quantity, sending a buyer a message) runs as a
# DRY RUN: the agent still gets a realistic tool result, but nothing is actually sent to
# eBay. Read-only calls (looking up listings/orders/messages, searching comparable
# listings) are unaffected by this flag and always run for real once credentials exist.
# Leave this false while you're testing prompts and only set it to true once you've
# verified behavior in EBAY_ENV=sandbox.
EBAY_LIVE_MODE=false
